# Cổng chạy phần mềm (mặc định 3000)
PORT=3000

# Để TRỐNG để dùng PostgreSQL nhúng (lưu trong thư mục data/pgdata) – không cần cài thêm gì.
# Điền chuỗi kết nối để dùng PostgreSQL riêng hoặc Supabase (gói miễn phí):
# DATABASE_URL=postgresql://postgres:MATKHAU@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Khóa ký phiên đăng nhập. Để trống: hệ thống tự sinh và lưu ở data/jwt.secret
JWT_SECRET=

# Đặt 0 để KHÔNG tạo dữ liệu mẫu ở lần chạy đầu tiên
SEED_SAMPLE=1
